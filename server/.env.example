# demo: 4,000 events/s; load: 20,000 events/s plus periodic peaks; stress: 50,000 events/s plus peaks
SIMULATOR_PROFILE=demo

# Use one seed to reproduce a test run. Any positive integer is valid.
SIMULATOR_SEED=20261111

# Alibaba Cloud Bailian / DashScope OpenAI-compatible API. Keep the real value in server/.env.
# DASHSCOPE_API_KEY=sk-...
# BAILIAN_MODEL=qwen-plus
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional overrides for the selected profile.
# SIMULATOR_DEVICE_COUNT=1000
# SIMULATOR_BATCH_SIZE=1000
# SIMULATOR_INTERVAL_MS=50
# SIMULATOR_BURST_EVERY_MS=15000
# SIMULATOR_BURST_DURATION_MS=3000
# SIMULATOR_BURST_MULTIPLIER=3
